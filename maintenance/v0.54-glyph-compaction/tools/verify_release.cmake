# Read-only check of a packaged source tree. No Python or generator required.
cmake_minimum_required(VERSION 3.22)
if(NOT DEFINED FCAIR_ROOT)
 get_filename_component(FCAIR_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
get_filename_component(FCAIR_ROOT "${FCAIR_ROOT}" REALPATH)
set(manifest "${FCAIR_ROOT}/RELEASE_SHA256.json")
if(NOT EXISTS "${manifest}")
 message(FATAL_ERROR "Release manifest missing: ${manifest}")
endif()
file(READ "${manifest}" hashes)
string(JSON kind ERROR_VARIABLE json_error TYPE "${hashes}")
if(json_error OR NOT kind STREQUAL "OBJECT")
 message(FATAL_ERROR "Invalid release manifest; expected a JSON object")
endif()
string(JSON count LENGTH "${hashes}")
if(count EQUAL 0)
 message(FATAL_ERROR "Empty release manifest")
endif()
math(EXPR last "${count}-1")
foreach(index RANGE 0 ${last})
 string(JSON name MEMBER "${hashes}" ${index})
 if(IS_ABSOLUTE "${name}" OR name MATCHES "(^|/)\\.\\.(/|$)" OR name MATCHES "[\\\\;]" OR name STREQUAL "")
  message(FATAL_ERROR "Unsafe path in release manifest")
 endif()
 string(JSON type TYPE "${hashes}" "${name}")
 string(JSON expected GET "${hashes}" "${name}")
 string(LENGTH "${expected}" digest_length)
 if(NOT type STREQUAL "STRING" OR NOT digest_length EQUAL 64 OR NOT expected MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "Invalid SHA256 for ${name}")
 endif()
 set(path "${FCAIR_ROOT}/${name}")
 if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
  message(FATAL_ERROR "Release file missing: ${name}")
 endif()
 file(REAL_PATH "${path}" real_path)
 string(FIND "${real_path}" "${FCAIR_ROOT}/" inside)
 if(NOT inside EQUAL 0 OR IS_SYMLINK "${path}")
  message(FATAL_ERROR "Release file escapes source tree: ${name}")
 endif()
 file(SHA256 "${path}" actual)
 if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Release SHA256 mismatch: ${name}")
 endif()
endforeach()
message(STATUS "Release verified: ${count} manifest files; contents unchanged")
